load("//buck2:haskell.bzl", "haskell_library")

# Cabal's `backend-api` library (glean.cabal.in): Backend API, and a few
# things built on top. Deliberately does NOT depend on glean:db (see the
# comment in glean.cabal.in) - db depends on this instead, for
# StackedDbOpts.
haskell_library(
    name = "backend-api",
    srcs = [
        "Glean/Backend/Types.hs",
        "Glean/Backend/Retry.hs",
        "Glean/Write/SendBatch.hs",
        "Glean/Query/Thrift.hs",
        "Glean/Query/Thrift/Internal.hs",
    ],
    deps = [
        "//hsthrift/common/util:fb-util",
        "//glean/if:if-glean-hs",
        "//glean/typed:typed",
        "//glean/util:util",
    ],
    packages = [
        "async",
        "containers",
        "data-default",
        "hashable",
        "haxl",
        "text",
        "unordered-containers",
    ],
    visibility = ["PUBLIC"],
)
