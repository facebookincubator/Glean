load("//buck2:haskell.bzl", "haskell_binary")

# Cabal's `glean` executable (glean.cabal.in) - the final target of this
# whole migration. `#if GLEAN_FACEBOOK` (GleanCLI.Facebook, Manifold/XDB
# backup, JustKnobs) and `#if ENABLE_S3` (Glean.Database.Backup.S3) blocks
# are excluded, matching every other GLEAN_FACEBOOK-gated piece in this
# migration - neither macro is ever defined.
