load("//buck2:haskell.bzl", "haskell_library")

# Cabal's `stubs` library (glean.cabal.in): open-source no-op/simplified
# implementations of things that have a real Meta-internal version under
# glean/facebook (fb303, auth headers, scribe writes, incomplete-db backup,
# shard publishing, indexing). Facebook.Service.HttpFb303 is included
# unconditionally - Cabal only builds it `if !flag(fbthrift)`, but we don't
# support the fbthrift flag with buck2 at all (see buck2.md TODO), so that
# branch is always the one that applies here.
#
# Glean/Init.hsc FFI-imports a real folly C++ symbol
# (folly::unsafe_unscoped_init) via Mangle.TH's TemplateHaskell `mangle`
# splice; the symbol itself comes from folly-clib (folly/init/Init.cpp),
# which is why folly-clib is a dep here even though nothing else in this
# library touches C++ directly.
haskell_library(
    name = "stubs",
    srcs = [
        "Facebook/Fb303.hs",
        "Facebook/Service.hs",
        "Facebook/Service/HttpFb303.hs",
        "Glean/Auth.hs",
        "Glean/BuildInfo.hs",
        "Glean/Database/Backup/Incomplete.hs",
        "Glean/Datasource/Scribe/Write.hs",
        "Glean/Init.hsc",
        "Glean/Server/PublishShards.hs",
        "Glean/Index.hs",
        "Glean/Username.hs",
        "ServiceData/Types.hs",
        "ServiceData/GlobalStats.hs",
        "TestRunner.hs",
    ],
    deps = [
        "//hsthrift/common/mangle:mangle",
        "//hsthrift/common/util:fb-util",
        "//hsthrift/folly-clib:folly-clib",
        "//hsthrift/http:thrift-http",
        "//hsthrift/lib:thrift-lib",
        "//glean/github/if:if-fb303-hs",
        "//glean/if:if-glean-hs",
        "//glean/if:if-index-hs",
    ],
    packages = [
        "HUnit",
        "bytestring",
        "http-types",
        "optparse-applicative",
        "process",
        "tasty",
        "tasty-hunit",
        "template-haskell",
        "text",
        "time",
        "unix",
        "unordered-containers",
        "wai",
    ],
    visibility = ["PUBLIC"],
)

# Cabal's `defaultconfigs` library (glean.cabal.in) - also hs-source-dirs:
# glean/github, but a separate Cabal library from `stubs` (private, only
# glean:core and a couple of others depend on it), so a separate buck2
# target here too even though it shares this directory.
haskell_library(
    name = "defaultconfigs",
    srcs = [
        "Glean/DefaultConfigs.hs",
    ],
    deps = [
        "//hsthrift/common/util:fb-util",
        "//glean/config:config",
        "//glean/util:util",
    ],
    packages = [
        "text",
    ],
    visibility = ["PUBLIC"],
)

# Cabal's `aclknobs` library (glean.cabal.in): open-source stub for the
# Facebook-internal ACL JustKnobs (glean/facebook has the real
# implementation) - both knobs default to False here, so ACL handling is
# disabled. No deps at all.
haskell_library(
    name = "aclknobs",
    srcs = [
        "Glean/Database/AclKnobs.hs",
    ],
    visibility = ["PUBLIC"],
)
