# Needs `--hie-indexer`/a matching GHC the same way glean-snapshot-haskell
# does - see glean/lang/haskell/tests/BUCK's comment for the full
# explanation (same GHC-version issue, same fix).
haskell_test(
    name = "glass-regression-haskell",
    main = "Glean.Glass.Regression.Haskell.Main",
    srcs = [
        "Glean/Glass/Regression/Haskell.hs",
        "Glean/Glass/Regression/Haskell/Main.hs",
    ],
    deps = [
        ":glass-regression",
        "//glean/lang/haskell:haskell-indexer",
    ],
    test_args = [
        "--hie-indexer=$(exe //glean/lang/haskell:hie-indexer)",
    ],
    test_env = {
        "PATH": GHC_BIN_DIR + ":/usr/bin:/bin",
    },
    visibility = ["PUBLIC"],
)

