load("//buck2:cxx.bzl", "cxx_library")

cxx_library(
    name = "lmdb-clib",
    # Genuine C, not C++ - gcc hard errors on -std=c++20 against a .c file,
    # so opt out of the wrapper's default (see buck2/cxx.bzl).
    cxx_std = False,
    srcs = [
        "mdb.c",
        "midl.c",
    ],
    compiler_flags = ["-DMDB_MAXKEYSIZE=0"],
    include_directories = ["."],
    public_include_directories = ["."],
    visibility = ["PUBLIC"],
)
