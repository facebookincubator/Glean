        "ownership/triearray.h",
        "ownership/uset.h",
        "prim.h",
        "query.h",
        "sanity.h",
        "serialize.h",
        "set.h",
        "stacked.h",
        "stats.h",
        "store.h",
        "string.h",
        "substitution.h",
        "thrift.h",
        "timer.h",
        "validate.h",
    ],
    compiler_flags = ["-DOSS=1"],
    exported_deps = [
        "//glean/bytecode:bytecode-cpp",
        "//third-party:icuuc",
        "//third-party:xxhash",
        # `id.h`/`error.h`/`ownership/triearray.h` (`exported_headers`
        # below) include <fmt/core.h> directly, so this needs to be one
        # of *this* library's own `exported_deps`, not just transitively
        # reachable via folly-clib (see `deps` below): folly-clib
        # exports fmt correctly to whoever depends on *it* directly, but
        # that's one hop too far - folly-clib is only a plain `dep` of
        # *rts*, and buck2's cxx_library() only forwards a library's
        # `exported_deps` preprocessor info to that library's own
        # consumers (`buck2/prelude/cxx/cxx_library.bzl`'s
        # `inherited_exported_preprocessor_infos`), not its plain
        # `deps`. So folly-clib's exported fmt flags reach rts.cpp's own
        # compilation fine, but stop there - anyone consuming *rts*'s
        # exported headers (glean/hs's hsc2hs preprocessing of a .hsc
        # file that transitively #include's id.h, in particular) never
        # saw them without this.
        "//third-party:fmt",
        "//third-party:gflags",
    ],
    deps = [
        "@hsthrift//common/util:fb-util-cxx",
        "@hsthrift//folly-clib:folly-clib",
    ],
    visibility = ["PUBLIC"],
)
