load("//buck2:haskell.bzl", "haskell_library")

# Cabal's `db` library (glean.cabal.in): the database layer - storage
# backends, lifecycle, janitor, write path, and the query compiler pipeline
# (Glean.Query.*) - see CLAUDE.md. Excludes db-backup-s3
# (glean/db/backup/s3/Glean/Database/Backup/S3.hs, Cabal's separate
# `db-backup-s3` library, `buildable: flag(s3-support)` - out of scope for
# now, same spirit as the fbthrift flag).
#
# -DOSS=1 (compiler_flags, not hsc_flags - there are no .hsc files here,
# just plain .hs with `{-# LANGUAGE CPP #-}`) matches Cabal's
# `cpp-options: -DOSS=1` and is genuinely required: unlike the
# MIN_VERSION_pkg(...) case (an undefined function-like macro, which GHC's
# CPP treats as true - see glean/github/BUCK's git history), `#ifdef OSS`
# is a plain existence check, and OSS must actually be *defined* to pick
# the open-source branch over the Meta-internal `#else` (e.g.
# Glean/Database/Create.hs's `#ifdef GLEAN_FACEBOOK` guards the reverse:
# omitted correctly by simply never defining that one).
#
# Paths_glean.hs is a small hand-written stand-in for Cabal's autogenerated
# Paths_glean module (see that file's own comment) - the only thing in
# `db` that actually needs it is Glean/Database/Config.hs's
# `#ifdef OSS \n import Paths_glean`.
haskell_library(
    name = "db",
    compiler_flags = ["-DOSS=1"],
    srcs = [
