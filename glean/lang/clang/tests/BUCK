load("//buck2:haskell.bzl", "haskell_library", "haskell_test")

_INDEXER_TEST_ARGS = ["--indexer=$(exe //glean/lang/clang:clang-index)"]

_COMMON_DEPS = [
    "@hsthrift//common/util:fb-util",
    "//glean/index:indexer-core",
    "//glean/lang/clang:clang-indexer",
    "//glean/lib:lib",
    "//glean/test/regression:regression-test-lib",
]

_DERIVE_DEPS = _COMMON_DEPS + [
    "//glean/if:if-glean-hs",
    "//glean/client/hs:client-hs",
    "//glean/hs:core",
    "//glean/lang/clang:clang-derive-lib",
]

_COMMON_PACKAGES = [
    "aeson",
    "json",
    "unordered-containers",
]

# Glean.Clang.Test and Glean.Clang.Test.DerivePass, shared by every
# haskell_test() below (and by glean/glass/test/regression:glass-
# regression-cpp) - a real haskell_library() instead of a
# native.export_file() per module (the previous approach): each
# consumer used to get its own from-scratch compile of these same two
# files as part of its own srcs, and a plain export_file() just hands a
# raw source file to whatever includes it, rather than something you
# can build/typecheck once and link against. Deps are the union of what
# each module needs (Test.hs only needs _COMMON_DEPS; DerivePass.hs,
# which imports Test.hs plus Derive.{Env,Lib,Types} from clang-derive-
# lib, needs the rest) - a harmless superset for the one consumer
# (clang-test-regression) that only uses Test.hs, since GHC only links
# in a library's actually-referenced modules regardless of what else
# the library contains.
haskell_library(
    name = "clang-test-lib",
    srcs = {
        "Glean/Clang/Test.hs": "Glean/Clang/Test.hs",
        "Glean/Clang/Test/DerivePass.hs": "Glean/Clang/Test/DerivePass.hs",
    },
    deps = _DERIVE_DEPS,
    packages = _COMMON_PACKAGES + ["data-default"],
    visibility = ["PUBLIC"],
)

haskell_test(
    name = "clang-test-regression",
    main = "Glean.Clang.Regression",
    srcs = {
        "Glean/Clang/Regression.hs": "github/Glean/Clang/Regression.hs",
        "Glean/Regression/Driver/Clang.hs": "Glean/Regression/Driver/Clang.hs",
    },
    deps = _COMMON_DEPS + [":clang-test-lib"],
    packages = _COMMON_PACKAGES,
    test_args = _INDEXER_TEST_ARGS,
    visibility = ["PUBLIC"],
)

haskell_test(
    name = "clang-test-derivefamilies",
    main = "Glean.Clang.DeriveFamilies",
    srcs = {
