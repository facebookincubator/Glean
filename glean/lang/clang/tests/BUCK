load("//buck2:haskell.bzl", "haskell_test")

# `--indexer=$(exe ...)` on the *-test targets below points each suite
# directly at this package's own clang-index build, rather than relying on
# `clang-index` being on `$PATH` (Glean.Indexer.Cpp's `withExe` falls back
# to a `$PATH` search when `-indexer` isn't given) - more hermetic under
# `buck2 test`, and the same fix removes the need to manually prepend
# clang-index's output dir onto `$PATH` the way this migration's own
# by-hand verification runs have had to (see buck2.md).
_INDEXER_TEST_ARGS = ["--indexer=$(exe //glean/lang/clang:clang-index)"]

# Cabal's 6 `clang-test-*` test-suites (glean.cabal.in): `common test`-free
# (these use plain `fb-haskell, fb-cpp, deps, exe`), sharing hs-source-dirs
# glean/lang/clang/tests and glean/lang/clang/tests/github (the latter has
# no BUCK file of its own, so it's part of this same package). The
# `github/Glean/Clang/*.hs` files declare `module Glean.Clang.X` (no
# `github.` prefix), so their module-name-derived object path doesn't
# match their on-disk path - `srcs` as a dict remaps them, same mechanism
# buck2/haskell.bzl's own doc comment describes for a source living
# somewhere other than its module name implies. (No `def` here for the
# obvious per-target helper - BUCK files, unlike `.bzl` ones, don't allow
# function definitions.)
_COMMON_DEPS = [
    "@hsthrift//common/util:fb-util",
    "//glean/index:indexer-core",
    "//glean/lang/clang:clang-indexer",
    "//glean/lib:lib",
    "//glean/test/regression:regression-test-lib",
]

_DERIVE_DEPS = _COMMON_DEPS + [
    "//glean/if:if-glean-hs",
    "//glean/client/hs:client-hs",
    "//glean/hs:core",
    "//glean/lang/clang:clang-derive-lib",
]

_COMMON_PACKAGES = [
    "aeson",
    "json",
    "unordered-containers",
]

haskell_test(
    name = "clang-test-regression",
    main = "Glean.Clang.Regression",
    srcs = {
        "Glean/Clang/Test.hs": "Glean/Clang/Test.hs",
        "Glean/Clang/Regression.hs": "github/Glean/Clang/Regression.hs",
        "Glean/Regression/Driver/Clang.hs": "Glean/Regression/Driver/Clang.hs",
    },
    deps = _COMMON_DEPS,
    packages = _COMMON_PACKAGES,
    test_args = _INDEXER_TEST_ARGS,
    visibility = ["PUBLIC"],
)

haskell_test(
    name = "clang-test-derivefamilies",
    main = "Glean.Clang.DeriveFamilies",
    srcs = {
