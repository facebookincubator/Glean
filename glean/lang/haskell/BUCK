load("//buck2:haskell.bzl", "haskell_binary", "haskell_library")

# Cabal's `indexers` library includes this module (Glean.Indexer.Haskell)
# among its 18 - see glean/index/BUCK's comment for the split rationale.
# (HieIndexer/* are a separate standalone executable, not part of
# `indexers`.)
haskell_library(
    name = "haskell-indexer",
    srcs = [
        "Glean/Indexer/Haskell.hs",
    ],
    deps = [
        "@hsthrift//common/util:fb-util",
        "//glean/index:indexer-core",
    ],
    packages = [
        "directory",
        "filepath",
        "optparse-applicative",
        "process",
    ],
    visibility = ["PUBLIC"],
)

# Cabal's `hie-indexer` executable (glean.cabal.in): reads GHC's .hie files
# (via the `hiedb`/`hie-compat` packages and the real `ghc` package) and
# writes the resulting facts to Glean. Gated on `common haskell-indexer`
# (GHC >= 9.2 - true for this toolchain's own GHC, so always buildable here).
haskell_binary(
    name = "hie-indexer",
    main = "HieIndexer.Main",
    srcs = [
        "HieIndexer/Main.hs",
        "HieIndexer/Index.hs",
        "HieIndexer/Options.hs",
    ],
    deps = [
        "@hsthrift//common/util:fb-util",
        "@hsthrift//lib:thrift-lib",
        "//glean/client/hs:client-hs",
        "//glean/client/hs/local:client-hs-local",
        "//glean/hs:core",
        "//glean/lib:lib",
        "//glean/github:stubs",
        "//glean/util:util",
        "//glean/schema/thrift:builtin",
        "//glean/schema/thrift:hs",
        "//glean/schema/thrift:src",
        "//glean/schema/hs:hs",
        "//glean/schema/hs:src",
    ],
    packages = [
        "ghc",
        "hie-compat",
        "hiedb",
    ],
    visibility = ["PUBLIC"],
)
