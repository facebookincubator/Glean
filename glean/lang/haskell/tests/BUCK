load("//buck2:haskell.bzl", "haskell_test")
load("//third-party/haskell:tools.bzl", "GHC_BIN_DIR")

# Cabal's `glean-snapshot-haskell` test-suite (glean.cabal.in): needs
# `hie-indexer` (//glean/lang/haskell:hie-indexer) and a GHC matching the
# one hie-indexer's own .hie-file reader was built against - Cabal's
# `build-tool-depends:` puts hie-indexer on PATH automatically under
# `cabal test`, and the ambient `cabal test` shell's own `ghc` happens to
# already be the right version; under buck2 there's no such guarantee
# (this shell's own default `ghc` may not match this toolchain's own -
# and hie-indexer panics on the resulting `.hie` file version mismatch:
# "readHieFile: hie file versions don't match ... Expected 9048 but got
# 9067" - see buck2.md), so both are passed explicitly via flags
# Glean.Indexer.Haskell already exposes for exactly this
# (`--hie-indexer`/`--with-ghc`) rather than relying on either being the
# right thing on `$PATH`.
haskell_test(
    name = "glean-snapshot-haskell",
    main = "Main",
    srcs = [
        "Main.hs",
    ],
    deps = [
        "//glean/lang/haskell:haskell-indexer",
        "//glean/test/regression:regression-test-lib",
    ],
    packages = [
        "text",
    ],
    test_args = [
        "--hie-indexer=$(exe //glean/lang/haskell:hie-indexer)",
    ],
    # `Main.hs` itself hardcodes `--with-ghc ghc` (bare, `$PATH`-resolved) -
    # passing our own `--with-ghc` again to override it errors out (this
    # parser rejects a flag given twice), so the only way to point it at
    # the right GHC is to make bare `ghc` resolve there via `$PATH`.
    test_env = {
        "PATH": GHC_BIN_DIR + ":/usr/bin:/bin",
    },
    visibility = ["PUBLIC"],
)
