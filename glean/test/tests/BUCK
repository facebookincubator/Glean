load("//buck2:haskell.bzl", "haskell_test")

# Cabal's `glean/test/tests` test-suites (glean.cabal.in's `common test`/
# `common angle-test` stanzas) - one haskell_binary() per test-suite, each
# depending on the specific `//glean/schema/{thrift,hs}:NAME` targets its own
# files actually import (grepped, not guessed - see buck2.md). A handful of
# test-suites needing whole not-yet-built subtrees (hack-derive-test,
# backup-s3, timeout, publish-shards) are deliberately left for later.

haskell_test(
    name = "angle-test-angle",
